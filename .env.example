# ==============================================================================
# EduGenie Environment Configuration
# Copy this file to .env and replace placeholders with your actual configuration.
# DO NOT commit the .env file to source control.
# ==============================================================================

# Google Gemini API Key (Required for live AI generation)
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Application Environment: 'development' or 'production'
ENVIRONMENT=development

# Production CORS Configuration
# Comma-separated list of allowed frontend origins (e.g., https://myfrontend.com,https://app.edugenie.com)
# In development, defaults to localhost/127.0.0.1 origins.
# In production, explicit origins are required and wildcard '*' is disallowed with credentials.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Whether to allow credentialed CORS requests (true/false)
# IMPORTANT: Never combined with wildcard '*' origins.
CORS_ALLOW_CREDENTIALS=false

# Request Size Limit in bytes (Default: 1048576 = 1MB)
MAX_REQUEST_SIZE_BYTES=1048576

# AI Client Timeouts and Retries
AI_TIMEOUT_SECONDS=10.0
AI_MAX_RETRIES=2

# Database Persistence Configuration (SQLite default for local prototype)
# On persistent hosting (or Docker volume), set to persistent directory (e.g. /data/edugenie.db)
DATABASE_PATH=data/edugenie.db

